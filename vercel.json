{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://document-tracking-system-3slm.onrender.com/api/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
